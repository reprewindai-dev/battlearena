<!-- Spitzone Open Graph Image -->
<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ogGradient1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FF6B35;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#F7931E;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FFD23F;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="ogGradient2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FF6B9D;stop-opacity:1" />
    </linearGradient>
    <filter id="ogGlow">
      <feGaussianBlur stdDeviation="8" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1200" height="630" fill="#000000" />
  
  <!-- Grid pattern -->
  <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
    <path d="M 60 0 L 0 0 0 60" fill="none" stroke="white" stroke-width="0.5" opacity="0.1"/>
  </pattern>
  <rect width="1200" height="630" fill="url(#grid)" />
  
  <!-- Background gradients -->
  <circle cx="200" cy="200" r="300" fill="url(#ogGradient1)" opacity="0.2" />
  <circle cx="1000" cy="400" r="250" fill="url(#ogGradient2)" opacity="0.2" />
  
  <!-- Logo -->
  <g transform="translate(600, 200)">
    <polygon
      points="0,-80 69,-40 69,40 0,80 -69,40 -69,-40"
      fill="none"
      stroke="url(#ogGradient1)"
      stroke-width="6"
      filter="url(#ogGlow)"
    />
    <polygon
      points="0,-50 43,-25 43,25 0,50 -43,25 -43,-25"
      fill="#1A1A2E"
      stroke="url(#ogGradient1)"
      stroke-width="4"
    />
    <g transform="translate(0, 0)">
      <rect x="-2" y="-40" width="4" height="56" fill="url(#ogGradient1)" />
      <polygon points="-2,-40 2,-40 0,-48" fill="url(#ogGradient1)" />
      <rect x="-4" y="16" width="8" height="5" fill="url(#ogGradient1)" />
      <rect x="-2" y="-40" width="4" height="56" fill="url(#ogGradient1)" transform="rotate(90)" />
      <polygon points="-2,-40 2,-40 0,-48" fill="url(#ogGradient1)" transform="rotate(90)" />
      <rect x="-4" y="16" width="8" height="5" fill="url(#ogGradient1)" transform="rotate(90)" />
    </g>
    <text x="0" y="120" text-anchor="middle" fill="url(#ogGradient1)" fontSize="32" fontWeight="bold" fontFamily="Arial Black, sans-serif">
      SZ
    </text>
  </g>
  
  <!-- Title -->
  <text x="600" y="380" text-anchor="middle" fill="white" fontSize="72" fontWeight="900" fontFamily="Arial Black, sans-serif">
    SPIT
  </text>
  <text x="600" y="460" text-anchor="middle" fill="url(#ogGradient1)" fontSize="72" fontWeight="900" fontFamily="Arial Black, sans-serif">
    ZONE
  </text>
  
  <!-- Tagline -->
  <text x="600" y="520" text-anchor="middle" fill="white" fontSize="24" fontWeight="600" fontFamily="Arial, sans-serif" opacity="0.8">
    Live Freestyle Battles
  </text>
  
  <!-- URL -->
  <text x="600" y="580" text-anchor="middle" fill="white" fontSize="18" fontFamily="Arial, sans-serif" opacity="0.6">
    spitzone.com
  </text>
</svg>
